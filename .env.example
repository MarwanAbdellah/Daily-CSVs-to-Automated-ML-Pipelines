# Copy to .env (docker compose and run.py both read it)

# --- Airflow containers -------------------------------------------------------
# Linux: set to the output of `id -u` so mounted files stay yours. Windows/macOS: keep 50000
AIRFLOW_UID=50000
# Web UI login (http://localhost:8080)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
# Shared secret of the Airflow API server; change it for anything beyond local use
AIRFLOW__API_AUTH__JWT_SECRET=change-me-local-dev-secret

# --- Project settings (src/config.py) -----------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Application environment: development, production
ENVIRONMENT=development
# Fraction of the Gold dates (the latest ones) held out for testing
TEST_FRACTION=0.2
# Random seed for the model
RANDOM_STATE=42
# Comma-separated batch dates whose FIRST attempt of extract_to_bronze fails on
# purpose, to prove retries (e.g. 2026-10-05). Leave empty normally.
SIMULATE_FAILURE_DATES=
# SQLAlchemy URI for the processed-data database. docker-compose.yml sets it for
# the containers; leave empty for local runs to skip the database load.
PROCESSED_DB_URI=
